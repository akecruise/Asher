# คัดลอกเป็น .env แล้วแก้ค่า — server อ่านให้เอง ไม่ต้องลง dotenv
# ค่าที่ตั้งไว้ใน environment จริงชนะค่าในไฟล์นี้เสมอ · สั่ง chmod 600 .env ด้วย
#
# ระบบนี้ไม่มี login ตั้งใจให้รันบนเครื่องตัวเองเท่านั้น (ระบบ login อยู่ที่ ASHER Connect)

# พอร์ตและ host ที่ bind — bind นอก 127.0.0.1 server จะไม่ยอมบูต
PORT=8000
HOST=127.0.0.1

# ที่เก็บไฟล์ข้อมูล ไม่ตั้งก็ใช้ data/ ในโปรเจกต์
ASHER_DATA_DIR=

# ปิดการดึงข้อมูลจากเว็บไซต์ (ตั้ง 0 ถ้าไม่ได้ใช้)
ASHER_ENABLE_SCRAPE=1

# ยอมให้ scraper ยิงเข้า network ภายใน — ใช้เฉพาะตอนดึงจาก staging ในวงแลนตัวเอง
ASHER_ALLOW_PRIVATE_HOSTS=0

# โดเมนอื่นที่ยอมให้เรียก API ข้ามโดเมนได้ คั่นด้วย comma — ไม่ตั้ง = same-origin เท่านั้น
ASHER_ALLOWED_ORIGINS=

# --- ใช้เฉพาะกรณีพิเศษ ---
# ยืนยันว่าจะเปิด server ออกนอก localhost ทั้งที่ไม่มี login (รับความเสี่ยงเอง)
ASHER_ALLOW_INSECURE=0

# อยู่หลัง reverse proxy: ให้ rate limit นับ IP จริง + จำนวน proxy ที่คั่นอยู่
ASHER_TRUST_PROXY=0
ASHER_PROXY_HOPS=1
