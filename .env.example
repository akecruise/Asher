# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit ไฟล์ .env จริงขึ้น git เด็ดขาด
# (บน Hostinger ตั้งค่าพวกนี้ในหน้า Node.js app -> Environment variables แทนก็ได้)

# --- บังคับตั้ง เวลา deploy ออกสาธารณะ ---
# รหัสผ่านสำหรับเข้าหน้าเว็บ อย่างน้อย 12 ตัวอักษร
# สุ่ม: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ASHER_PASSWORD=

# --- ตัวเลือกเพิ่มเติม ---
# token สำหรับเรียก API จากสคริปต์/โมดูลอื่น (Authorization: Bearer <token>)
ASHER_TOKEN=

# secret ของ session cookie — ไม่ตั้งก็ได้ (จะ derive จากรหัสผ่านให้)
# ตั้งเองเมื่อต้องการให้ session อยู่รอดแม้เปลี่ยนรหัสผ่าน
ASHER_SESSION_SECRET=

# อายุ session (ชั่วโมง) ค่าเริ่มต้น 12
ASHER_SESSION_HOURS=12

# ที่เก็บไฟล์ข้อมูล — ต้องชี้ออกนอกโฟลเดอร์เว็บ ไม่งั้น deploy ทับแล้วข้อมูลหาย
ASHER_DATA_DIR=/home/USERNAME/asher-data

# อยู่หลัง reverse proxy (Hostinger / Nginx) ตั้ง 1 ให้ rate limit นับ IP จริง
ASHER_TRUST_PROXY=1

# บังคับ Secure บน cookie (ตั้งเมื่อเปิด HTTPS แล้วแต่ proxy ไม่ส่ง x-forwarded-proto)
ASHER_COOKIE_SECURE=1

# โดเมนอื่นที่ยอมให้เรียก API ข้ามโดเมนได้ คั่นด้วย comma — ไม่ตั้ง = same-origin เท่านั้น
ASHER_ALLOWED_ORIGINS=

# ปิดการดึงข้อมูลจากเว็บไซต์ (ตั้ง 0 ถ้าไม่ได้ใช้ จะได้ไม่มีใครเอา server ไปใช้เป็น proxy)
ASHER_ENABLE_SCRAPE=1

# ยอมให้ scraper ยิงเข้า network ภายใน — ใช้เฉพาะตอน dev เท่านั้น ห้ามเปิดบน host
ASHER_ALLOW_PRIVATE_HOSTS=0

# พอร์ตและ host ที่ bind (Hostinger มักกำหนด PORT ให้เอง)
PORT=8000
HOST=127.0.0.1
